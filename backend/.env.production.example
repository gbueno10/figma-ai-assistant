# Configuração de Produção para Figma AI Assistant Backend

# OpenAI API Key (OBRIGATÓRIO)
OPENAI_API_KEY=sk-your-production-openai-key

# Porta do servidor
PORT=3000

# Node Environment
NODE_ENV=production

# CORS Configuration
# Lista de origens permitidas separadas por vírgula
# Exemplos:
#   - Domínio específico: https://meusite.com
#   - Múltiplos domínios: https://site1.com,https://site2.com
#   - Permitir tudo: * (NÃO RECOMENDADO para produção)
CORS_ORIGIN=https://seu-dominio.com

# Logging Level (opcional)
# LOG_LEVEL=info

# Rate Limiting (quando implementado)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# Database (se necessário no futuro)
# DATABASE_URL=postgresql://user:password@host:5432/database

# Redis (para cache, se implementado)
# REDIS_URL=redis://localhost:6379
