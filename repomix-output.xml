        await figma.clientStorage.setAsync(IMAGE_BANK_FOLDER_STORAGE_KEY, msg.imageBankFolder || '');
        console.log(`✅ Folders saved: Exports=${msg.exportsFolder || 'none'}, Image Bank=${msg.imageBankFolder || 'none'}`);

